<mujoco model="so101_pick_place">
  <include file="../third_party/ICL-so101/sim/so101/so101_new_calib_camera.xml"/>
  <compiler angle="radian"
            meshdir="../third_party/ICL-so101/sim/so101/assets"
            autolimits="true"/>

  <option cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <global azimuth="150" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.02 0.02 0.03"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.22 0.28 0.34" rgb2="0.12 0.16 0.20" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.15"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="1 1 0.05" material="groundplane"
          friction="1.2 0.02 0.002"/>

    <geom name="target_pad" type="cylinder" pos="0.20 0.12 0.002"
          size="0.055 0.002" rgba="0.15 0.85 0.25 0.55"
          contype="0" conaffinity="0"/>

    <body name="block" pos="0.25 0 0.015">
      <freejoint name="block_freejoint"/>
      <geom name="block_geom" type="box" size="0.015 0.015 0.015"
            mass="0.025" rgba="0.9 0.15 0.12 1"
            friction="1.5 0.03 0.003" condim="4"/>
    </body>

    <!-- Screen-right is +Y and screen-up is -X.  The 20-degree tilt keeps
         height changes visible without sacrificing the planar mapping. -->
    <camera name="observation" pos="0.440 0.050 0.704"
            xyaxes="0 1 0 -0.9396926 0 0.3420201" fovy="48"/>
  </worldbody>
</mujoco>
